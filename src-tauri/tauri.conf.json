{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OOOSplat",
  "version": "0.3.0",
  "identifier": "studio.ooo.splat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OOOSplat",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eef1f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../engines/": "engines/",
      "../licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installerIcon": null,
        "installMode": "perMachine",
        "compression": "bzip2"
      }
    }
  }
}
